{
  "name": "@chat/db",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "build": "pnpm db:generate && tsc -p tsconfig.json",
    "db:push": "pnpm prisma db push",
    "db:reset": "pnpm prisma migrate reset",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:generate": "pnpm prisma generate",
    "db:migrate": "pnpm prisma migrate dev",
    "db:studio": "pnpm prisma studio",
    "dev": "tsc -w  -p tsconfig.json"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    }
  },
