{
  "name": "chat",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "dev:packages": "pnpm --filter \"./packages/**\" run --parallel dev",
    "dev:server": "pnpm --filter ./apps/server  start:dev",
    "dev:client": "pnpm --filter ./apps/client dev",
    "build:packages": "pnpm --filter \"./packages/**\" run --r build",
    "build:shared": "pnpm --filter ./packages/shared/ build",
    "build:server": "pnpm --filter ./apps/server/ build",
    "build:client": "pnpm --filter ./apps/client/ build",
    "db:generate": "pnpm --filter ./packages/db db:generate",
    "db:migrate": "pnpm --filter @chat/db db:migrate",
    "db:reset": "pnpm --filter @chat/db db:reset",
    "db:studio": "pnpm --filter @chat/db db:studio",
    "load-test:auth": "pnpm --filter ./apps/server load-test:auth",
    "load-test:messaging": "pnpm --filter ./apps/server load-test:messaging",
    "load-test:setup": "pnpm --filter ./apps/server load-test:setup",
    "load-test:all": "pnpm --filter ./apps/server load-test:all",
    "dev": "pnpm --parallel run dev",
    "build": "pnpm -r run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "dependencies": {
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright": "^1.65.1"
  }
}
